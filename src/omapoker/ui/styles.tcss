/* OmaPoker - Omarchy palette: accent green on a dark, low-contrast base. */

Screen {
    background: #16161e;
    color: #c0caf5;
}

/* ---------------------------------------------------------------- header */

#topbar {
    dock: top;
    height: 3;
    background: #1f2335;
    border-bottom: solid #3b4261;
    padding: 0 1;
}

#topbar-left {
    width: 1fr;
    content-align: left middle;
    height: 3;
}

#topbar-right {
    width: auto;
    height: 3;
    align-horizontal: right;
}

#music-chip {
    width: auto;
    height: 1;
    padding: 0 1;
    background: #24283b;
    color: #c0caf5;
}

#music-chip:hover {
    background: #3b4261;
}

#music-chip-wrap {
    width: auto;
    height: 1;
    margin-top: 1;
}

#music-source {
    width: 3;
    min-width: 3;
    height: 1;
    border: none;
    padding: 0;
    margin-left: 1;
}

#music-bars {
    width: 14;
    height: 1;
    margin-right: 1;
}

/* ----------------------------------------------------------------- table */

#table-body {
    height: 1fr;
    padding: 0;
}

/* The room: paints the floor, and the ring is mounted on top of it. */
#room {
    height: 1fr;
    width: 1fr;
    background: #0e0e16;
}

#ring {
    height: 1fr;
    width: 1fr;
    align-horizontal: center;
    align-vertical: middle;
    overflow: auto auto;
}

/* Rows are full width; equal 1fr fills at each end centre whatever is in them
   (align-horizontal alone cannot centre the contents of a row layout). */
.ring-row {
    height: auto;
    align-vertical: middle;
    width: 100%;
}

.seat-fill {
    width: 1fr;
    height: 1;
}

SeatCard {
    border: round #3b4261;
    background: #1f2335;
    padding: 0 1;
    margin: 0 1;
    width: 31;
    height: 4;
    color: #c0caf5;
}

.seat-spacer {
    width: 31;
    height: 4;
    margin: 0 1;
}

.hero-row .seat-spacer {
    width: 31;
}

SeatCard.you {
    border: round #7aa2f7;
}

SeatCard.hero-seat {
    width: 38;
    height: 6;
    border: heavy #7aa2f7;
    background: #24283b;
}

SeatCard.active {
    border: round #9ece6a;
    background: #24283b;
}

SeatCard.folded {
    color: #565f89;
    background: #1a1b26;
}

SeatCard.busted {
    color: #565f89;
    border: dashed #3b4261;
}

/* The table itself: padded rail (outer border), felt (inner frame). */
#poker-table {
    border: round #7a5c3e;
    background: #33241a;
    padding: 1 3;
    margin: 0 1;
    height: 12;
    width: 48;
    align-horizontal: center;
}

#felt {
    width: 1fr;
    height: 1fr;
    border: round #4f7a3d;
    background: #173b2a;
    padding: 0 1;
    align-horizontal: center;
    align-vertical: middle;
}

#felt-mark {
    color: #e0c07a;
    text-style: bold;
    text-align: center;
    width: 100%;
    height: 1;
}

#board-panel {
    background: transparent;
    padding: 0;
    height: auto;
    width: auto;
    color: #c0caf5;
    text-align: center;
}

/* ----------------------------------------------------------------- coach */

#coach-panel {
    border: round #3b4261;
    background: #1f2335;
    padding: 0 1;
    height: auto;
    max-height: 8;
    overflow-y: auto;
    width: 1fr;
}

#log-panel {
    border: round #3b4261;
    background: #16161e;
    height: auto;
    max-height: 8;
    width: 34;
    padding: 0 1;
}

#bottom-rows {
    height: auto;
    max-height: 9;
    padding: 0 1;
}

#coach-row {
    height: auto;
    max-height: 12;
}

/* ------------------------------------------------------------- actionbar */

#actionbar {
    dock: bottom;
    height: auto;
    background: #1f2335;
    border-top: solid #3b4261;
    padding: 0 1;
}

#action-buttons {
    height: auto;
    align-vertical: middle;
}

#actionbar Button {
    margin: 0 1 0 0;
    min-width: 10;
}

#bet-input {
    width: 14;
    margin: 0 1 0 0;
}

#bet-quick {
    width: auto;
    height: auto;
}

#bet-quick Button {
    min-width: 6;
    margin: 0 1 0 0;
    height: 3;
}

#action-hint {
    height: 1;
    color: #565f89;
}

/* ------------------------------------------------------------- menu etc. */

#menu-shell {
    align-horizontal: center;
    align-vertical: top;
    height: 1fr;
    padding: 1 2;
}

#menu-card {
    border: round #9ece6a;
    background: #1f2335;
    padding: 1 2;
    width: 76;
    max-width: 100%;
    height: auto;
}

#menu-title {
    color: #9ece6a;
    text-align: center;
}

#menu-sub {
    color: #565f89;
    text-align: center;
}

#menu-card Button {
    width: 100%;
    margin: 0 0 1 0;
}

#menu-actions {
    grid-size: 2;
    grid-columns: 1fr 1fr;
    grid-rows: 3;
    grid-gutter: 0 1;
    height: 15;
    margin-top: 1;
}

#menu-actions Button {
    height: 3;
    min-width: 0;
    margin: 0;
}

.panel {
    border: round #3b4261;
    background: #1f2335;
    padding: 1 2;
    height: auto;
}

#panel-scroll {
    height: 1fr;
    padding: 0 2;
}

.section-title {
    color: #9ece6a;
    text-style: bold;
    margin: 1 0 0 0;
}

.dim {
    color: #565f89;
}

.warn {
    color: #e0af68;
}

/* --------------------------------------------------------------- ladder */

#ladder-shell {
    align-horizontal: center;
    height: 1fr;
    padding: 0 2;
}

/* The picker reuses the menu card, but here it holds the ladder itself. */
#ladder-shell > #menu-card {
    width: 90;
    height: 1fr;
    max-height: 100%;
    margin: 0;
}

#ladder-controls {
    height: auto;
    margin: 1 0;
}

#ladder-controls Select {
    width: 1fr;
    margin: 0 1 0 0;
}

#ladder-controls Button {
    width: auto;
    min-width: 12;
    margin: 0 0 0 1;
}

#ladder-list {
    height: 1fr;
    border: round #3b4261;
    background: #1a1b26;
}

#ladder-broke {
    color: #e0af68;
    margin-top: 1;
}

.bad {
    color: #f7768e;
}

.good {
    color: #9ece6a;
}

#dial-row Button {
    min-width: 4;
    margin: 0 1 0 0;
}

#dial-row {
    height: auto;
    align-vertical: middle;
}

#stats-table {
    height: auto;
    max-height: 20;
}

#lessons-list {
    height: auto;
    max-height: 14;
    border: round #3b4261;
    background: #16161e;
}

#lesson-body {
    height: auto;
    max-height: 18;
    overflow-y: auto;
    padding: 0 1;
}

#music-panel Table {
    height: auto;
}

#overlay {
    align-horizontal: center;
    align-vertical: middle;
    background: #16161e 90%;
}

#overlay-card {
    border: round #9ece6a;
    background: #1f2335;
    padding: 1 2;
    width: auto;
    max-width: 80;
    height: auto;
}

PrivacyScreen, PrivacyScreen #overlay {
    background: #16161e;
}

#result-card {
    border: round #9ece6a;
    background: #1f2335;
    padding: 1 2;
    width: auto;
    max-width: 90;
    height: auto;
}

DataTable {
    height: auto;
}

TabbedContent {
    height: 1fr;
}

TabPane {
    padding: 0 1;
}
